# Copy to .env. Never commit real credentials.
DATABASE_URL="postgresql://workflow:workflow@localhost:5432/workflow"
REDIS_URL="redis://localhost:6379"
# Keep inline locally. Production requires Redis and a separate `npm run worker --workspace=@workflow/api` worker process.
EXECUTION_QUEUE_MODE="inline"
# Optional namespace override for isolated tests or multiple installations sharing Redis.
EXECUTION_QUEUE_NAME="workflow-executions"
# Optional Redis Pub/Sub namespace for cross-process execution SSE updates.
EXECUTION_EVENTS_CHANNEL="workflow-execution-events"
# Maximum simultaneous jobs per worker process. Scale workers before raising this aggressively.
EXECUTION_WORKER_CONCURRENCY="2"
SCHEDULER_ENABLED="true"
# API-only background maintenance: expire abandoned worker leases and prune terminal execution data.
EXECUTION_MAINTENANCE_ENABLED="true"
EXECUTION_RETENTION_SUCCESS_DAYS="14"
EXECUTION_RETENTION_FAILED_DAYS="30"
EXECUTION_RETENTION_MAX_COUNT="10000"
WEB_ORIGIN="http://localhost:3000"
# Optional, comma-separated internal hostnames explicitly permitted for outbound nodes.
# Do not use "*". Public HTTP(S) destinations are allowed; private/reserved networks remain blocked by default.
OUTBOUND_ALLOWED_HOSTNAMES=""
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
APP_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# Generate an APP_ENCRYPTION_KEY locally with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/oauth/google/callback"
# Add this second redirect URI to the same Google OAuth client for account sign-in.
GOOGLE_AUTH_REDIRECT_URI="http://localhost:3001/api/v1/auth/google/callback"
# GitHub account sign-in is independent of Google connector credentials.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_AUTH_REDIRECT_URI="http://localhost:3001/api/v1/auth/github/callback"
# Steam uses OpenID identity verification, not OAuth API authorization. Both URLs
# must share the same origin in production (normally the public API origin).
STEAM_OPENID_RETURN_URI="http://localhost:3001/api/v1/auth/steam/callback"
STEAM_OPENID_REALM="http://localhost:3001"
