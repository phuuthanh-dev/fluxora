# Copy to .env. Never commit real credentials.
DATABASE_URL="postgresql://workflow:workflow@localhost:5432/workflow"
REDIS_URL="redis://localhost:6379"
# Keep inline locally. Production requires Redis and a separate `npm run worker --workspace=@workflow/api` worker process.
EXECUTION_QUEUE_MODE="inline"
# Optional namespace override for isolated tests or multiple installations sharing Redis.
EXECUTION_QUEUE_NAME="workflow-executions"
# Optional Redis Pub/Sub namespace for cross-process execution SSE updates.
EXECUTION_EVENTS_CHANNEL="workflow-execution-events"
# Maximum simultaneous jobs per worker process. Scale workers before raising this aggressively.
EXECUTION_WORKER_CONCURRENCY="2"
SCHEDULER_ENABLED="true"
# API-only background maintenance: expire abandoned worker leases and prune terminal execution data.
EXECUTION_MAINTENANCE_ENABLED="true"
EXECUTION_RETENTION_SUCCESS_DAYS="14"
EXECUTION_RETENTION_FAILED_DAYS="30"
EXECUTION_RETENTION_MAX_COUNT="10000"
WEB_ORIGIN="http://localhost:3000"
# System account recovery mail, independent of workflow SMTP credentials. Disabled by default.
# Enable only after configuring a verified sender and testing delivery. TLS 465 or STARTTLS 587.
ACCOUNT_MAIL_ENABLED="false"
ACCOUNT_SMTP_HOST=""
ACCOUNT_SMTP_PORT="587"
ACCOUNT_SMTP_USER=""
ACCOUNT_SMTP_PASSWORD=""
ACCOUNT_MAIL_FROM=""
# Public HTTPS API origin used only when provider-managed webhook registration is enabled.
PUBLIC_API_ORIGIN=""
# Keep false until provider lifecycle qualification and reconciliation are complete.
GITHUB_WEBHOOK_AUTOMATION_ENABLED="false"
# Optional, comma-separated internal hostnames explicitly permitted for outbound nodes.
# Do not use "*". Public HTTP(S) destinations are allowed; private/reserved networks remain blocked by default.
OUTBOUND_ALLOWED_HOSTNAMES=""
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
APP_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# Jira data reporting stays disabled until the personal-data erasure process is reviewed.
JIRA_PRIVACY_REPORTING_ENABLED="false"
JIRA_REPORTING_WORKSPACE_ID=""
JIRA_REPORTING_CREDENTIAL_ID=""
# Generate an APP_ENCRYPTION_KEY locally with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/oauth/google/callback"
SLACK_APP_ID=""
SLACK_SIGNING_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:3001/api/v1/oauth/slack/callback"

# Public Notion OAuth; keep private client secret server-side. Manual tokens remain supported.
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
NOTION_REDIRECT_URI="http://localhost:3001/api/v1/oauth/notion/callback"
# Exact Fluxora user ID allowed to access the platform administration area.
# Empty disables the area; workspace owners are not automatically admins.
PLATFORM_ADMIN_USER_ID=""
# Add this second redirect URI to the same Google OAuth client for account sign-in.
GOOGLE_AUTH_REDIRECT_URI="http://localhost:3001/api/v1/auth/google/callback"
# GitHub account sign-in is independent of Google connector credentials.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_AUTH_REDIRECT_URI="http://localhost:3001/api/v1/auth/github/callback"
# Steam uses OpenID identity verification, not OAuth API authorization. Both URLs
# must share the same origin in production (normally the public API origin).
STEAM_OPENID_RETURN_URI="http://localhost:3001/api/v1/auth/steam/callback"
STEAM_OPENID_REALM="http://localhost:3001"
# Optional AI output token ceiling per request (1–8192); configure consistently
# on every API and worker. This is not an aggregate or monetary spending cap.
AI_MAX_OUTPUT_TOKENS="8192"
AI_MAX_PROMPT_CHARACTERS="100000"

# Jira Cloud OAuth 3LO app (optional; use HTTPS callback in production)
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""
JIRA_REDIRECT_URI="" # e.g. http://localhost:3001/api/v1/oauth/jira/callback
# Enable only with a public HTTPS API origin and webhook query-string log redaction.
JIRA_WEBHOOK_AUTOMATION_ENABLED="false"
