# Copy to /opt/workflow-automation/.env.production on the VPS and chmod 600.
# Never commit the real file.

POSTGRES_USER=workflow
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=workflow

IMAGE_TAG=
API_IMAGE=ghcr.io/phuuthanh-dev/workflow-automation-api
WEB_IMAGE=ghcr.io/phuuthanh-dev/workflow-automation-web
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
WEB_ORIGIN=https://app.example.com

NODE_ENV=production
EXECUTION_QUEUE_MODE=redis
EXECUTION_WORKER_CONCURRENCY=2
SCHEDULER_ENABLED=true
EXECUTION_MAINTENANCE_ENABLED=true
EXECUTION_RETENTION_SUCCESS_DAYS=14
EXECUTION_RETENTION_FAILED_DAYS=30
EXECUTION_RETENTION_MAX_COUNT=10000

JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
APP_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Keep each provider group empty or configure its complete group together.
# The callback values stay empty until the matching client ID and secret exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AUTH_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_AUTH_REDIRECT_URI=
STEAM_OPENID_RETURN_URI=
STEAM_OPENID_REALM=

