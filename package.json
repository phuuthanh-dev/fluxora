{
  "name": "workflow-automation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@workflow/web",
    "dev:api": "npm run dev --workspace=@workflow/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:deploy": "node --env-file-if-exists=.env ./scripts/run-prisma.mjs migrate deploy",
    "db:validate": "node --env-file-if-exists=.env ./scripts/run-prisma.mjs validate",
    "verify": "npm run db:validate && npm run test && npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  }
}
