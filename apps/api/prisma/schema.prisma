generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  EDITOR
  VIEWER
}

enum AuthIdentityProvider {
  GOOGLE
  GITHUB
  STEAM
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CredentialProvider {
  STEAM
  RIOT
  GOOGLE
  GOOGLE_CHAT_WEBHOOK
  HTTP
  DISCORD_WEBHOOK
  SLACK_WEBHOOK
  SLACK_OAUTH
  TELEGRAM_BOT
  GITHUB
  GITLAB
  JIRA
  SMTP
  GEMINI
  OPENAI
  MONGODB
  NOTION
  POSTGRES
  GMAIL
  GOOGLE_CALENDAR
  GOOGLE_CHAT_OAUTH
  TRELLO
  SENTRY
  VERCEL
  SUPABASE
  REDDIT
}

// Provider writes can succeed even when the response is lost. Pending and
// uncertain states must never be silently retried as new creates.
enum ProviderWebhookState {
  CREATING
  CREATE_DISPATCHING
  CREATE_UNCERTAIN
  CREATE_REJECTED
  ACTIVE
  DELETING
  DELETE_UNCERTAIN
  REMOVED
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NodeExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  WAITING
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String?
  displayName     String?
  avatarColor     String            @default("lime")
  disabledAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sessions        Session[]
  identities      AuthIdentity[]
  auditLogs       AuditLog[]
  executionViews  ExecutionSavedView[]
  passwordResets  PasswordReset[]
  accountMail     AccountMail[]
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum AccountMailState {
  PENDING
  SENDING
  SENT
  FAILED
}

model AccountMail {
  id               String           @id @default(uuid())
  userId           String
  kind             String
  encryptedPayload String?
  state            AccountMailState @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  expiresAt        DateTime
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
}

model AuthIdentity {
  id                String               @id @default(uuid())
  userId            String
  provider          AuthIdentityProvider
  providerAccountId String
  email             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  workflows   Workflow[]
  credentials Credential[]
  auditLogs   AuditLog[]
  executionViews ExecutionSavedView[]
}

model ExecutionSavedView {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  name        String
  filter      String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, name])
  @@index([workspaceId, userId])
}

model WorkspaceMember {
  id          String         @id @default(uuid())
  workspaceId String
  userId      String
  role        MembershipRole @default(OWNER)
  createdAt   DateTime       @default(now())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Workflow {
  id                 String            @id @default(uuid())
  workspaceId        String
  name               String
  description        String?
  archivedAt         DateTime?
  isActive           Boolean           @default(false)
  activatedAt        DateTime?
  failureAlertProvider String?
  failureAlertCredentialId String?
  failureAlertChatId String?
  draftVersionId     String?           @unique
  publishedVersionId String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions           WorkflowVersion[] @relation("WorkflowVersions")
  draftVersion       WorkflowVersion?  @relation("WorkflowDraftVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)
  publishedVersion   WorkflowVersion?  @relation("WorkflowPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  webhookEndpoints   WebhookEndpoint[]
  rssTriggerCheckpoints RssTriggerCheckpoint[]
  calendarTriggerCheckpoints CalendarTriggerCheckpoint[]

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, archivedAt, updatedAt])
}

model WorkflowVersion {
  id          String                @id @default(uuid())
  workflowId  String
  version     Int
  status      WorkflowVersionStatus @default(DRAFT)
  graph       Json
  createdAt   DateTime              @default(now())
  publishedAt DateTime?
  workflow    Workflow              @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  draftFor    Workflow?             @relation("WorkflowDraftVersion")
  publishedFor Workflow?            @relation("WorkflowPublishedVersion")
  executions  Execution[]
  webhookEndpoints WebhookEndpoint[]
  providerWebhookRegistrations ProviderWebhookRegistration[]
  gmailTriggerCheckpoints GmailTriggerCheckpoint[]

  @@unique([workflowId, version])
  @@index([workflowId, status])
}

// Progress belongs to a published version and trigger node. A page token is
// committed only after its messages have been durably dispatched.
model GmailTriggerCheckpoint {
  workflowVersionId String
  nodeId            String
  historyId         String
  mailboxHash       String
  pageToken         String?
  state             String   @default("READY")
  leaseToken        String?
  leaseExpiresAt    DateTime?
  nextPollAt        DateTime?
  lastErrorCode     String?
  updatedAt         DateTime @updatedAt
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  deliveries        GmailTriggerDelivery[]

  @@id([workflowVersionId, nodeId])
  @@index([state, leaseExpiresAt])
}

model GmailTriggerDelivery {
  workflowVersionId String
  nodeId            String
  messageId         String
  executionId       String?
  dispatchedAt      DateTime?
  skipReason        String?
  createdAt         DateTime @default(now())
  checkpoint        GmailTriggerCheckpoint @relation(fields: [workflowVersionId, nodeId], references: [workflowVersionId, nodeId], onDelete: Cascade)

  @@id([workflowVersionId, nodeId, messageId])
}

// RSS progress belongs to a workflow and trigger identity, so an unchanged
// trigger can carry its bounded history across published versions without
// copying receipts into every historical version.
model RssTriggerCheckpoint {
  workflowId        String
  nodeId            String
  workflowVersionId String
  feedUrlHash       String
  snapshot          Json
  etag              String?
  lastModified      String?
  state             String   @default("READY")
  leaseToken        String?
  leaseExpiresAt    DateTime?
  nextPollAt        DateTime?
  lastErrorCode     String?
  lastCheckedAt     DateTime?
  updatedAt         DateTime @updatedAt
  workflow          Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  deliveries        RssTriggerDelivery[]

  @@id([workflowId, nodeId])
  @@index([state, nextPollAt, leaseExpiresAt])
}

model RssTriggerDelivery {
  workflowId String
  nodeId     String
  itemKey    String
  lastSeenAt DateTime @default(now())
  executionId String? @unique
  checkpoint RssTriggerCheckpoint @relation(fields: [workflowId, nodeId], references: [workflowId, nodeId], onDelete: Cascade)
  execution  Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@id([workflowId, nodeId, itemKey])
  @@index([lastSeenAt])
}

// The sync cursor and event revisions belong to a workflow and trigger node.
model CalendarTriggerCheckpoint {
  workflowId        String
  nodeId            String
  workflowVersionId String
  configHash        String
  syncToken         String
  baselineAt        DateTime
  pageToken         String?
  state             String   @default("READY")
  leaseToken        String?
  leaseExpiresAt    DateTime?
  nextPollAt        DateTime?
  lastErrorCode     String?
  updatedAt         DateTime @updatedAt
  workflow          Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  seen              CalendarTriggerSeen[]
  deliveries        CalendarTriggerDelivery[]

  @@id([workflowId, nodeId])
  @@index([state, nextPollAt, leaseExpiresAt])
}

model CalendarTriggerSeen {
  workflowId   String
  nodeId       String
  eventKey     String
  revisionHash String
  checkpoint   CalendarTriggerCheckpoint @relation(fields: [workflowId, nodeId], references: [workflowId, nodeId], onDelete: Cascade)

  @@id([workflowId, nodeId, eventKey])
}

model CalendarTriggerDelivery {
  workflowId  String
  nodeId      String
  changeKey   String
  executionId String? @unique
  createdAt   DateTime @default(now())
  checkpoint  CalendarTriggerCheckpoint @relation(fields: [workflowId, nodeId], references: [workflowId, nodeId], onDelete: Cascade)

  @@id([workflowId, nodeId, changeKey])
}

model Credential {
  id            String             @id @default(uuid())
  workspaceId   String
  provider      CredentialProvider
  label         String
  encryptedData String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerWebhookRegistrations ProviderWebhookRegistration[]

  @@unique([workspaceId, provider, label])
  @@index([workspaceId, provider])
}

// Retained independently of a credential: execution history can outlive it.
model JiraPrivacyAccount {
  accountHash        String   @id
  encryptedAccountId String
  oldestDataAt       DateTime
  nextReportAt       DateTime
  lastReportedAt     DateTime?
  state              String   @default("READY")
  requiredAction     String?
  claimedAt          DateTime?
  claimToken         String?
  lastErrorCode      String?
  // Attribution remains after the connection is removed. Older records need review.
  credentialIds      String[] @default([])
  workspaceIds       String[] @default([])
  coverageReviewedAt DateTime?
  lastAttemptAt      DateTime?
  cycleDays          Int      @default(7)
  updatedAt          DateTime @updatedAt

  @@index([state, nextReportAt])
}

model Execution {
  id                String          @id @default(uuid())
  workflowVersionId String
  status            ExecutionStatus @default(QUEUED)
  mode              String          @default("LIVE")
  idempotencyKey    String?         @unique
  // Keyed digest for guarded Kuma, Telegram and Vercel deliveries.
  // Existing executions and other providers continue to use NULL.
  webhookPayloadDigest String?
  idempotencyRootId String?
  triggerData       Json?
  privacyErasedAt   DateTime?
  errorCode         String?
  errorMessage      String?
  errorRetryable    Boolean?
  failureAlertClaimedAt DateTime?
  // A claim may outlive the process or a provider response may be lost.
  // Only mark SENT after the provider confirms the request.
  failureAlertOutcome String?
  startedAt         DateTime?
  completedAt       DateTime?
  leaseExpiresAt    DateTime?
  recoveryCount     Int             @default(0)
  // Fences state writes made by a worker from an earlier running phase.
  runToken          String?
  // A queued approval continuation is persisted before queue dispatch. Its
  // nonce fences older initial/resume jobs from claiming a later phase.
  resumeToken       String?         @unique
  resumeNodeIds     Json?
  resumeQueuedAt    DateTime?
  createdAt         DateTime        @default(now())
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  nodeExecutions    NodeExecution[]
  approvalRequests  ApprovalRequest[]
  rssDelivery       RssTriggerDelivery?

  @@index([workflowVersionId, createdAt])
  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([status, resumeQueuedAt])
}

model NodeExecution {
  id           String              @id @default(uuid())
  executionId  String
  nodeId       String
  status       NodeExecutionStatus @default(PENDING)
  attempt      Int                 @default(0)
  input        Json?
  output       Json?
  errorCode    String?
  errorMessage String?
  errorRetryable Boolean?
  startedAt    DateTime?
  completedAt  DateTime?
  execution    Execution           @relation(fields: [executionId], references: [id], onDelete: Cascade)
  items        NodeExecutionItem[]

  @@unique([executionId, nodeId])
  @@index([executionId, status])
}

model NodeExecutionItem {
  id               String              @id @default(uuid())
  nodeExecutionId  String
  itemIndex        Int
  parentNodeId     String?
  parentItemIndex  Int?
  status           NodeExecutionStatus @default(PENDING)
  attempt          Int                 @default(0)
  input            Json?
  output           Json?
  errorCode        String?
  errorMessage     String?
  errorRetryable   Boolean?
  startedAt        DateTime?
  completedAt      DateTime?
  nodeExecution    NodeExecution       @relation(fields: [nodeExecutionId], references: [id], onDelete: Cascade)

  @@unique([nodeExecutionId, itemIndex])
}

model ApprovalRequest {
  id          String    @id @default(uuid())
  executionId String
  tokenHash   String    @unique
  status      ApprovalRequestStatus @default(PENDING)
  expiresAt   DateTime
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, status])
}

model WebhookEndpoint {
  id           String   @id @default(uuid())
  workflowId   String
  workflowVersionId String
  path         String   @unique
  secretHash   String?
  encryptedSigningSecret String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  providerRegistration ProviderWebhookRegistration?

  @@index([workflowVersionId])
}

// Not yet used by the manual webhook flow. Provider operations own exactly
// one recorded identity per endpoint; only that identity may be removed.
model ProviderWebhookRegistration {
  id                     String               @id @default(uuid())
  endpointId             String               @unique
  provider               String
  repository             String
  event                  String
  callbackUrl            String
  credentialId           String
  workflowVersionId      String
  encryptedSigningSecret String
  state                  ProviderWebhookState
  operationId            String               @unique
  remoteHookId           BigInt?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  endpoint               WebhookEndpoint      @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  credential             Credential           @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  workflowVersion        WorkflowVersion       @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)

  @@unique([provider, repository, remoteHookId], map: "ProviderWebhookRegistration_remote_identity_key")
  @@index([state, updatedAt])
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  graph       Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One shared gate deliberately serializes Riot calls across local workers.
model RiotApiGuard {
  id           String   @id
  blockedUntil DateTime
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String?
  actorId     String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
}
